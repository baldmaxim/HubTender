# Образец настроек бота. Скопируйте файл в bot.env и заполните.
# Формат: КЛЮЧ=значение, по одной настройке в строке; комментарии — со строки, начинающейся с #.
# Бот читает настройки только из этого файла; переменные окружения Windows не использует (кроме прокси HTTPS_PROXY).

# Токен бота от @BotFather (обязательно).
TELEGRAM_BOT_TOKEN=

# Ключ доступа к API TenderHUB (обязательно): Администрирование → Доступ к API → «Выпустить ключ».
TENDERHUB_API_KEY=

# Адрес API TenderHUB с https; /api/v1 бот допишет сам. Не tender.su10.ru — он указывает на другой сервер.
# TENDERHUB_API_URL=https://gp.su10.ru/api/v1

# Как часто забирать очередь уведомлений, секунды.
# CLAIM_INTERVAL_SECONDS=30

# Адрес Telegram Bot API (меняют только если api.telegram.org недоступен напрямую).
# TELEGRAM_API_BASE_URL=https://api.telegram.org

# Файл журнала (по умолчанию bot.log в папке бота).
# LOG_FILE=bot.log

# Прокси задаётся не здесь, а переменными окружения Windows HTTPS_PROXY / HTTP_PROXY (см. README).
