# Настройки ИИ-проверки (scripts/ai-review).
# Скопируйте этот файл рядом под именем ai-review.env и заполните.
# ai-review.env в git не попадает (.gitignore).
#
# Скрипт читает ТОЛЬКО этот файл. Переменные окружения (в том числе
# TENDERHUB_API_URL / TENDERHUB_API_KEY из других скриптов) не учитываются.
# Формат: KEY=VALUE, по строке на ключ. Комментарий — только отдельной строкой
# с «#» в начале (в конце строки со значением он станет частью значения).

# --- Портал TenderHUB ---------------------------------------------------------
# Адрес портала без /api/v1 и без хвостового «/». Для локального BFF —
# http://localhost:3005.
TENDERHUB_API_URL=https://gp.su10.ru

# Ключ API (вида thk_...). Выпуск: Настройки -> Доступ к API -> Ключи.
# Права ключа: tenders:read, verification:read, verification:write.
TENDERHUB_API_KEY=

# --- Модели -------------------------------------------------------------------
# Имена профилей через запятую (a-z, 0-9, _). Для каждого имени ниже
# описывается набор AI_REVIEW_<ИМЯ>_*, где ИМЯ — в верхнем регистре.
AI_REVIEW_MODELS=qwen,minimax

# Профиль qwen: офисная модель.
# BASE_URL — OpenAI-совместимый адрес сервера:
#   Ollama      http://<ПК>:11434/v1
#   LM Studio   http://<ПК>:1234/v1
#   vLLM        http://<ПК>:8000/v1
#   OpenRouter  https://openrouter.ai/api/v1
AI_REVIEW_QWEN_BASE_URL=
AI_REVIEW_QWEN_MODEL=qwen3.8-27b-pricer-rl648
# Ключ локальной Ollama / LM Studio не нужен — оставьте пустым.
AI_REVIEW_QWEN_API_KEY=
# Необязательно (значения по умолчанию в скобках):
# Контекст модели в токенах, под который сверяется ping (16384).
#AI_REVIEW_QWEN_CONTEXT=16384
# Таймаут одного запроса, секунды; медленной карте нужно много (900).
#AI_REVIEW_QWEN_TIMEOUT_SEC=900
# Лимит токенов ответа, включая рассуждения (8192).
#AI_REVIEW_QWEN_MAX_TOKENS=8192
# JSON-объект, вливаемый в тело каждого запроса chat/completions, например
# отключение рассуждений у Qwen:
#AI_REVIEW_QWEN_EXTRA={"chat_template_kwargs":{"enable_thinking":false}}

# Профиль minimax: облачная модель через OpenRouter.
# Ключ OpenRouter: https://openrouter.ai/keys. Данные тендера уходят во внешний сервис.
AI_REVIEW_MINIMAX_BASE_URL=https://openrouter.ai/api/v1
AI_REVIEW_MINIMAX_MODEL=minimax/minimax-m3.1-flash:free
AI_REVIEW_MINIMAX_API_KEY=
#AI_REVIEW_MINIMAX_CONTEXT=16384
#AI_REVIEW_MINIMAX_TIMEOUT_SEC=900
#AI_REVIEW_MINIMAX_MAX_TOKENS=8192
#AI_REVIEW_MINIMAX_EXTRA=
