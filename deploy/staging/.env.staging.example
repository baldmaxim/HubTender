# HUBTender staging — шаблон. Скопировать в .env.staging НА STAGING HOST
# (вне git; chmod 600) и заполнить. Реальные значения в репозиторий не попадают.
#
# Guard-инварианты (проверяются скриптами deploy/staging/*):
#   * DB-имя обязано содержать "staging";
#   * DSN НЕ должен указывать на mdb.yandexcloud.net / supabase / production host;
#   * JWT-ключ — ОТДЕЛЬНЫЙ staging-ключ, не production;
#   * OPENROUTER_API_KEY задаётся ТОЛЬКО при STAGING_OPENROUTER_MODE=separate_key.

# ── compose-параметры ────────────────────────────────────────────────────────
STAGING_IMAGE=hubtender:staging-0bffa67          # immutable tag/digest, не latest
STAGING_DOMAIN=staging.example.com               # НЕ production-домен
STAGING_DB_NAME=hubtender_staging
STAGING_DB_USER=hubtender_staging
STAGING_DB_PASSWORD=__CHANGE_ME__
STAGING_WEB_BIND=0.0.0.0                         # dedicated_host: 0.0.0.0; isolated_same_host: 127.0.0.1 за host-proxy
STAGING_WEB_PORT=443
STAGING_WEB_HTTP_PORT=80

# ── backend (env_file для api-контейнера) ────────────────────────────────────
APP_ENV=staging
DATABASE_URL=postgres://hubtender_staging:__CHANGE_ME__@db:5432/hubtender_staging?sslmode=disable
PORT=3005
BIND_HOST=0.0.0.0
CORS_ORIGINS=https://staging.example.com
APP_JWT_ISSUER=https://staging.example.com
APP_JWT_AUDIENCE=hubtender-web
APP_JWT_KEY_ID=staging-1
APP_JWT_PRIVATE_KEY_PATH=/keys/jwt-staging.pem   # отдельный staging RSA-ключ (mount)
APP_ACCESS_TOKEN_TTL_MINUTES=15
APP_REFRESH_TOKEN_TTL_DAYS=7
APP_BASE_URL=https://staging.example.com
LOG_LEVEL=info
# Notifications на staging ВЫКЛЮЧЕНЫ: SMTP не задаём (NoopMailer).
# SMTP_HOST=

# Recovery — как в production (default включён).
# RECALC_RECOVERY_ENABLED=true

# ── AI / OpenRouter ──────────────────────────────────────────────────────────
# fake-режим: ключ НЕ задавать; для E2E поднимается fake-сервер
#   (scripts/readiness/fake-openrouter-server.mjs) и:
# OPENROUTER_API_BASE=http://127.0.0.1:8391
# OPENROUTER_LIVE_TEST=true
# separate_key-режим: ТОЛЬКО отдельный staging-ключ:
# OPENROUTER_API_KEY=__STAGING_ONLY_KEY__
# Rollout всегда стартует off (seed миграции); env-переключателя нет.

# ── staging test users (для seed-скрипта; НЕ production-учётки) ──────────────
STAGING_ADMIN_EMAIL=admin@staging.example.com
STAGING_ADMIN_PASSWORD=__CHANGE_ME__
STAGING_REGULAR_EMAIL=user@staging.example.com
STAGING_REGULAR_PASSWORD=__CHANGE_ME__
STAGING_PILOT_EMAIL=pilot@staging.example.com
STAGING_PILOT_PASSWORD=__CHANGE_ME__
